# --- Identity / token contract (must match each product's verifier) ---------
# ISSUER must equal the ATS backend's AUTH_ISSUER.
ISSUER=http://localhost:8100
# DEFAULT_AUDIENCE must equal the ATS backend's AUTH_AUDIENCE.
DEFAULT_AUDIENCE=ats
ALLOWED_AUDIENCES=["ats","vms"]
ACCESS_TOKEN_TTL_SECONDS=300
REFRESH_TOKEN_TTL_SECONDS=2592000

# --- Signing key (RS256) ----------------------------------------------------
# Dev: a keypair is generated at PRIVATE_KEY_PATH on first run.
# Prod: inject the PEM directly (secret manager) and/or pin KEY_ID.
PRIVATE_KEY_PATH=./signing_key.pem
# PRIVATE_KEY_PEM=
# KEY_ID=

# --- Database ---------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./auth.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/mxtng_auth

# --- Refresh cookie ---------------------------------------------------------
REFRESH_COOKIE_NAME=mxtng_refresh
REFRESH_COOKIE_SECURE=true
# REFRESH_COOKIE_DOMAIN=.mxtng.com
# lax is enough when the product shares a registrable domain with this service
# (app.mxtng.com + auth.mxtng.com). A product on an unrelated host — a
# *.vercel.app deployment, say — is cross-site and needs "none" (Secure required),
# otherwise the browser never sends the cookie and refresh always 401s.
REFRESH_COOKIE_SAMESITE=lax

# --- Login hardening --------------------------------------------------------
MAX_FAILED_LOGINS=5
LOGIN_LOCKOUT_SECONDS=900
RESET_TOKEN_TTL_SECONDS=1800

# --- Session policy (ADR-0012) ----------------------------------------------
# One live session per account: signing in anywhere ends every other session.
SINGLE_SESSION_PER_CREDENTIAL=true

# --- Sign-in challenge (emailed OTP, ADR-0011) ------------------------------
# Mandatory and no longer switchable. The single-step /v1/login was removed
# (SECURITY_AUDIT C-2): it issued tokens on a password alone, so nothing proved
# the person controlled the mailbox — and the ATS turns an email domain into
# agency membership. A mail path is therefore required for the service to start.
OTP_CODE_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_CHALLENGE=3

# --- Outbound mail (ADR-0011) -----------------------------------------------
# Primary path: the ATS platform-mail relay. MAIL_RELAY_SECRET must equal the ATS
# backend's MAIL_RELAY_SECRET, or every sign-in code fails to send.
MAIL_RELAY_URL=http://localhost:8000/api/v1/internal/mail
# No default: the service refuses to start in production without it.
MAIL_RELAY_SECRET=
MAIL_RELAY_TIMEOUT_SECONDS=10.0

# Break-glass path, used only when the relay is unreachable or has no active SMTP
# configuration. WITHOUT THIS A FRESH ENVIRONMENT CANNOT BE BOOTSTRAPPED: setting up
# mail in the ATS portal requires a sign-in, and signing in requires mail. It is also
# what keeps an ATS outage from taking down sign-in for every product.
# FALLBACK_SMTP_HOST=smtp.example.com
# FALLBACK_SMTP_PORT=587
# FALLBACK_SMTP_USERNAME=
# FALLBACK_SMTP_PASSWORD=
# FALLBACK_SMTP_USE_TLS=true
MAIL_FROM_EMAIL=no-reply@mxtng.local
MAIL_FROM_NAME=MXTNG
# Product page that trades a reset token for a new password; unset mails the bare token.
# PASSWORD_RESET_URL=http://localhost:3000/reset-password

# --- Sign-in-with-Google (optional; routes are disabled when unset) ---------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8100/v1/google/callback
# Google sign-in is challenged too (ADR-0011): the callback redirects here with
# ?challenge=, which the ATS forwards to /login/verify.
# GOOGLE_POST_LOGIN_REDIRECT=http://localhost:3000/login/google/callback

# --- IdentityEvent webhooks (product receivers) -----------------------------
WEBHOOK_ENDPOINTS=[]
# Required whenever WEBHOOK_ENDPOINTS is non-empty. Unsigned identity events
# are not emitted at all.
WEBHOOK_SECRET=

# --- Admin (service-to-service identity mutations) --------------------------
# These endpoints reassign a credential's email address. Unset closes the
# surface (503) rather than opening it, and production refuses to boot without
# a real value (SECURITY_AUDIT H-1).
ADMIN_API_KEY=

# --- CORS -------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000"]

# --- HTTP hardening ---------------------------------------------------------
# Host header allow-list. "*" is refused in production.
TRUSTED_HOSTS=["localhost","127.0.0.1"]
# Turn on ONLY behind a proxy that overwrites X-Forwarded-For; otherwise the
# rate limiter and the audit trail key on a header any client can set.
TRUST_PROXY_HEADERS=false

# --- Rate limiting (per IP, per minute) -------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_SIGNUP_PER_MINUTE=5
RATE_LIMIT_RESET_PER_MINUTE=3
RATE_LIMIT_INTROSPECT_PER_MINUTE=120

# --- Sign-in-with-Google CSRF nonce -----------------------------------------
# How long an authorization request stays open. The nonce is stored server-side
# and burned on first use (SECURITY_AUDIT H-3).
OAUTH_STATE_TTL_SECONDS=600

# --- Debug ------------------------------------------------------------------
# Returns a live password-reset token in the HTTP response. Development only —
# production refuses to start with this on (SECURITY_AUDIT M-10).
DEBUG_ECHO_RESET_TOKENS=false
